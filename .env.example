# Expo アプリの公開設定。このファイルを .env にコピーして値を埋める（.env は git 管理外）
# EXPO_PUBLIC_ で始まる値はビルドに埋め込まれるので、シークレットは置かない

# バックエンド（server/）の URL。iOS シミュレータと Web は localhost で OK。
# Android エミュレータは `adb reverse tcp:8080 tcp:8080` を実行すると localhost で届く
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Firebase のウェブアプリ設定（Firebase コンソール → プロジェクトの設定 → マイアプリ → firebaseConfig）
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=my-calendar-app-509416.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=my-calendar-app-509416
EXPO_PUBLIC_FIREBASE_APP_ID=

# Firebase Auth エミュレータに接続する場合（server/ もエミュレータモードで起動していること）。本物に接続するなら空にする
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
