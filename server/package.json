{
  "name": "my-calendar-app-server",
  "version": "0.1.0",
  "private": true,
  "description": "カレンダー連携アプリのバックエンド（Cloud Run / Node.js 22 + TypeScript）",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@googleapis/calendar": "^20.0.0",
    "@hono/node-server": "^1.13.0",
    "firebase-admin": "^13.0.0",
    "google-auth-library": "^11.1.0",
    "hono": "^4.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.2",
    "vitest": "^3.0.0"
  }
}
