# このファイルを .env にコピーして値を埋める（.env は git 管理外）

# サーバー
PORT=8080
NODE_ENV=development

# Google Cloud / Firebase のプロジェクト ID
# ローカルでは `gcloud auth application-default login` で認証するか、下のエミュレータを使う
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# アプリの利用を許可するメールアドレス（カンマ区切り）。ここに無いアカウントは API を呼べない
OWNER_EMAILS=you@example.com

# Google OAuth（フェーズ 1 で使用）
# クライアントシークレットは本番では Secret Manager から環境変数として注入する。リポジトリや chat には書かない
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8080/auth/google/callback
APP_DEEP_LINK=mycalendarapp://linked
