# このファイルを .env にコピーして値を埋める（.env は git 管理外）

# サーバー
PORT=8080
NODE_ENV=development

# Google Cloud / Firebase のプロジェクト ID
# ローカルでは `gcloud auth application-default login` で認証するか、下のエミュレータを使う
GOOGLE_CLOUD_PROJECT=my-calendar-app-509416
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8090
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# アプリの利用を許可するメールアドレス（カンマ区切り）。ここに無いアカウントはログインも API 利用もできない
OWNER_EMAILS=you@example.com

# Google OAuth（ウェブ アプリケーション種別のクライアント。ログインとアカウント連携の両方で使う）
# クライアントシークレットは本番では Secret Manager から環境変数として注入する。リポジトリや chat には書かない
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Google Cloud コンソールの「承認済みのリダイレクト URI」に同じ値を登録する
OAUTH_REDIRECT_URI=http://localhost:8080/auth/google/callback

# OAuth 完了後にアプリへ戻る URL として許可する先頭文字列（カンマ区切り）
# mycalendarapp:// = 開発ビルド / exp:// = Expo Go / http://localhost = Web
APP_RETURN_URL_PREFIXES=mycalendarapp://,exp://,http://localhost

# OAuth の state の有効期間（秒）
OAUTH_STATE_TTL_SECONDS=600

# リフレッシュトークンの暗号鍵（base64 の 32 バイト）。`openssl rand -base64 32` で生成する
# 本番では必須。開発で空のままにすると平文で保存される（起動時に警告が出る）
TOKEN_ENCRYPTION_KEY=

# Cloud Scheduler からの /tasks/* 呼び出しを認証する共有シークレット（X-Tasks-Secret ヘッダー）
# 本番では必須。開発で空なら認証なしで呼べる。`openssl rand -hex 24` などで生成する
TASKS_SECRET=

# このサービスの公開 URL（例: https://xxx.run.app）。設定すると Google の変更通知（events.watch）を受ける
# ローカル開発では空のままにし、/tasks/poll のポーリングだけで同期する
PUBLIC_BASE_URL=

# Web 版アプリを公開している URL（例: https://<サイト>.web.app）。CORS とログイン後の戻り先に許可する
WEB_APP_URL=

# 同期エラー・復旧・再認証が必要になったときに通知する Slack の Incoming Webhook の URL（任意）
# 空なら通知しない
SLACK_WEBHOOK_URL=
